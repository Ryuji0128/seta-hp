# www.kaza-love.com → kaza-love.com リダイレクト (HTTP)
server {
    listen 80;
    server_name www.${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

# 旧ドメイン setaseisakusyo.com → kaza-love.com リダイレクト (HTTP)
server {
    listen 80;
    server_name ${OLD_SERVER_NAME} www.${OLD_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

# kaza-love.com HTTP → HTTPS リダイレクト
server {
    listen 80;
    server_name ${SERVER_NAME};

    # Let's Encrypt 認証用
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # HTTPSへリダイレクト（証明書がある場合のみ機能）
    location / {
        return 301 https://$host$request_uri;
    }
}
