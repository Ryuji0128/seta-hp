# gzip 圧縮（http コンテキスト＝全 server に適用）。
# 画像/動画など既に圧縮済みのものは対象にしない。text/html は既定で常に圧縮される。
gzip on;
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 256;
gzip_proxied any;
gzip_types
    text/plain
    text/css
    text/xml
    application/javascript
    application/json
    application/xml
    application/rss+xml
    application/wasm
    image/svg+xml
    font/woff
    font/woff2;

# www.kaza-love.com → kaza-love.com リダイレクト (HTTP)
server {
    listen 80;
    server_name www.${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

# 旧ドメイン setaseisakusyo.com → kaza-love.com リダイレクト (HTTP)
server {
    listen 80;
    server_name ${OLD_SERVER_NAME} www.${OLD_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

# kaza-love.com HTTP → HTTPS リダイレクト
server {
    listen 80;
    server_name ${SERVER_NAME};

    # Let's Encrypt 認証用
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # HTTPSへリダイレクト（証明書がある場合のみ機能）
    location / {
        return 301 https://$host$request_uri;
    }
}

# designer.kaza-love.com HTTP → HTTPS リダイレクト（証明書発行のACMEチャレンジも配信）
server {
    listen 80;
    server_name designer.${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
