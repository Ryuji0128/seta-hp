# =========================================
# SETA Craft - .env テンプレート
# =========================================
# このファイルをコピーして next/.env を作成し、各値を設定してください:
#   cp next/.env.example next/.env
#
# 注意:
# - .env は .gitignore 済み。シークレットを含めて絶対にコミットしないこと
# - 本番環境では .env をサーバー上で直接管理し、リポジトリには本ファイルのみ保持

# ---- Database ----
# 開発（Docker）では docker-compose.dev.yml の environment で上書きされます
DATABASE_URL="mysql://app_user:app_pass@mysql:3306/app_db"

# ---- NextAuth (必須) ----
# 32バイトのランダム値を生成: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_TRUST_HOST="true"

# ---- 管理者シード (任意。npx prisma db seed で使用) ----
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""

# ---- Google OAuth (任意) ----
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=""

# ---- reCAPTCHA v3 (任意 / 問い合わせフォームで使用) ----
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""
# ALLOWED_RECAPTCHA_HOSTNAMES="localhost"

# ---- SMTP (任意 / メール送信を使う場合) ----
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# CONTACT_TO_EMAIL=""
