# =========================================
# 飾Love (運営: 瀬田製作所) - .env テンプレート
# =========================================
# このファイルをコピーして next/.env を作成し、各値を設定してください:
#   cp next/.env.example next/.env
#
# 注意:
# - .env は .gitignore 済み。シークレットを含めて絶対にコミットしないこと
# - 本番環境では .env をサーバー上で直接管理し、リポジトリには本ファイルのみ保持

# ---- Database ----
# 開発（Docker）では docker-compose.dev.yml の environment で上書きされます
DATABASE_URL="mysql://app_user:app_pass@mysql:3306/app_db"

# ---- Rate Limit Store (任意) ----
# 省略時は本番/DB接続時に database、それ以外は memory を自動選択
# RATE_LIMIT_STORE="database"


# ---- NextAuth (必須) ----
# 32バイトのランダム値を生成: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# 非 Docker(直接 yarn dev)の場合の既定値。Docker 開発は docker-compose.dev.yml で
# 上書きされ http://localhost:3001 になります(ホスト側ポート 3001 にマッピング済み)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_TRUST_HOST="true"

# ---- SSO / Designer (任意) ----
# 親ドメイン配下のDesignerへNextAuthセッションを共有する本番設定
# SSO_COOKIE_DOMAIN=".kaza-love.com"
# SSO_COOKIE_SECURE="1"
# SSO_VERIFY_ENABLED="1"
# NEXT_PUBLIC_DESIGNER_URL="https://designer.kaza-love.com"

# ---- 社内レビューコメント (任意) ----
# true の環境だけUIとAPIを有効化
# NEXT_PUBLIC_ENABLE_COMMENTS="true"

# ---- 管理者シード (任意。npx prisma db seed で使用) ----
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""

# ---- Google OAuth (任意) ----
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=""

# ---- reCAPTCHA v3 (任意 / 問い合わせフォームで使用) ----
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""
# ALLOWED_RECAPTCHA_HOSTNAMES="localhost"

# ---- SMTP (任意 / メール送信を使う場合) ----
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# CONTACT_TO_EMAIL=""
